#!/bin/bash
# NATION AGENT — papy launcher
# The main entry point. Use 'papy' to interact with NATION AGENT from anywhere.
#
# Usage: papy [command] [args...]
#
# Commands (standalone, no kiro-cli needed):
#   (none)           Launch kiro-cli chat with NATION AGENT
#   tui              Open the TUI interface
#   web [port]       Start the web dashboard
#   banner           Show the banner
#   health           Run health check
#   memory [args]    Access memory system
#   skills [args]    Manage skills
#   heal [args]      Self-healing tools
#   tool <name> ...  Run any nation tool directly
#   status           Show agent status
#   help             Show this help
#
NATION_DIR="${HOME}/.kiro"
TOOLS="${NATION_DIR}/tools"
LIB="${NATION_DIR}/lib"

# Source platform lib
[ -f "$LIB/nation-platform.sh" ] && source "$LIB/nation-platform.sh" 2>/dev/null || true

CMD="${1:-}"

case "$CMD" in
  "")
    # Show banner then launch kiro-cli
    "$TOOLS/nation-banner.sh" full 2>/dev/null || true
    if command -v kiro-cli &>/dev/null; then
        exec kiro-cli chat --agent nation-agent
    else
        echo "kiro-cli not found. Install from: https://kiro.dev"
        echo ""
        echo "Available papy commands:"
        echo "  papy tui     - Terminal UI"
        echo "  papy web     - Web dashboard"
        echo "  papy health  - Health check"
        exit 1
    fi
    ;;
  tui)
    shift
    exec "$TOOLS/nation-tui.sh" "$@"
    ;;
  web)
    shift
    exec "$TOOLS/nation-web.sh" "$@"
    ;;
  banner)
    shift
    exec "$TOOLS/nation-banner.sh" "${1:-full}"
    ;;
  health)
    exec "$TOOLS/nation-heal.sh" check
    ;;
  memory|mem)
    shift
    exec "$TOOLS/nation-memory.sh" "$@"
    ;;
  skills|skill)
    shift
    exec "$TOOLS/nation-skills.sh" "$@"
    ;;
  heal)
    shift
    exec "$TOOLS/nation-heal.sh" "$@"
    ;;
  adb)
    shift
    exec "$TOOLS/nation-adb.sh" "$@"
    ;;
  apk)
    shift
    exec "$TOOLS/nation-apk.sh" "$@"
    ;;
  tool)
    shift
    TOOL_NAME="${1:-}"
    [ -n "$TOOL_NAME" ] || { echo "Usage: papy tool <name> [args...]"; echo "Tools: $(ls $TOOLS/nation-*.sh | xargs -I{} basename {} .sh | sed 's/nation-//' | tr '\n' ' ')"; exit 1; }
    shift
    TOOL_SCRIPT="$TOOLS/nation-${TOOL_NAME}.sh"
    [ -x "$TOOL_SCRIPT" ] || { echo "Tool not found: $TOOL_NAME"; exit 1; }
    exec "$TOOL_SCRIPT" "$@"
    ;;
  status)
    "$TOOLS/nation-banner.sh" minimal 2>/dev/null || true
    echo ""
    "$TOOLS/nation-heal.sh" check 2>/dev/null
    ;;
  update)
    echo "Updating NATION AGENT from GitHub..."
    curl -fsSL https://raw.githubusercontent.com/ogbas4991/nation-agent/main/install.sh | bash
    ;;
  help|--help|-h)
    "$TOOLS/nation-banner.sh" minimal 2>/dev/null || true
    echo ""
    grep '^#' "$0" | grep -v '#!/' | sed 's/^# //' | sed 's/^#//'
    echo ""
    echo "Available tools:"
    ls "$TOOLS"/nation-*.sh 2>/dev/null | xargs -I{} basename {} .sh | sed 's/nation-/  papy tool /' | sort
    ;;
  *)
    echo "Unknown command: $CMD"
    echo "Run: papy help"
    exit 1
    ;;
esac
