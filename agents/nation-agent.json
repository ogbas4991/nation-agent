{
  "name": "nation-agent",
  "description": "Production-quality local-first AI coding agent for Termux. Self-healing, persistent memory, 11 tool modules, MCP bridge. Reads/edits files, automates tasks, runs shell commands, manages projects entirely on-device.",
  "prompt": "file:///root/.kiro/prompts/nation-agent.txt",

  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "code",
    "web_fetch",
    "web_search"
  ],

  "allowedTools": [
    "read",
    "grep",
    "glob",
    "code",
    "@filesystem",
    "@filesystem/read_file",
    "@filesystem/list_directory",
    "@filesystem/search_files",
    "@filesystem/get_file_info"
  ],

  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "~/**",
        "/root/**",
        "/data/data/com.termux/files/home/**"
      ],
      "deniedPaths": [
        "/etc/**",
        "/sys/**",
        "/proc/**",
        "/dev/**"
      ]
    },
    "shell": {
      "allowedCommands": [
        "git status",
        "git diff",
        "git log",
        "git add",
        "git commit",
        "git branch",
        "git checkout",
        "git pull",
        "git stash",
        "git clone",
        "git remote",
        "git tag",
        "git blame",
        "git show",
        "git init",
        "git reset HEAD",
        "python3",
        "python",
        "node",
        "npm run",
        "npm test",
        "npm install",
        "npm list",
        "pip3",
        "pip",
        "ls",
        "cat",
        "head",
        "tail",
        "find",
        "grep",
        "sed",
        "awk",
        "echo",
        "mkdir",
        "cp",
        "mv",
        "chmod",
        "touch",
        "wc",
        "sort",
        "uniq",
        "diff",
        "which",
        "env",
        "export",
        "date",
        "uname",
        "pwd",
        "whoami",
        "bash",
        "sh",
        "make",
        "curl",
        "pkg",
        "apt",
        "~/.kiro/tools/nation-"
      ],
      "deniedCommands": [
        "rm -rf /",
        "rm -rf \\$HOME",
        "dd if=",
        "mkfs",
        "chmod -R 777 /",
        "> /dev/sda",
        "git push --force",
        "git reset --hard"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.python\\.org.*",
        ".*nodejs\\.org.*",
        ".*developer\\.mozilla\\.org.*",
        ".*docs\\.npmjs\\.com.*",
        ".*git-scm\\.com.*",
        ".*github\\.com.*",
        ".*stackoverflow\\.com.*",
        ".*pypi\\.org.*",
        ".*httpbin\\.org.*"
      ]
    }
  },

  "resources": [
    "file://README.md",
    "file://.gitignore",
    "file://package.json",
    "file://requirements.txt",
    "file://pyproject.toml",
    "file://Makefile",
    "file://Cargo.toml",
    "skill://.kiro/skills/nation-tools/SKILL.md"
  ],

  "hooks": {
    "agentSpawn": [
      {
        "command": "~/.kiro/hooks/nation-spawn.sh",
        "timeout_ms": 15000
      }
    ],
    "preToolUse": [
      {
        "matcher": "*",
        "command": "~/.kiro/hooks/nation-pre-tool.sh",
        "timeout_ms": 5000
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "~/.kiro/hooks/nation-post-tool.sh",
        "timeout_ms": 8000
      }
    ],
    "stop": [
      {
        "command": "~/.kiro/hooks/nation-stop.sh",
        "timeout_ms": 8000
      }
    ]
  },

  "mcpServers": {
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": ["/root", "/data/data/com.termux/files/home"],
      "timeout": 30000
    },
    "github": {
      "command": "mcp-server-github",
      "args": [],
      "env": {
        "GITHUB_TOKEN": "$GITHUB_TOKEN"
      },
      "timeout": 30000
    }
  },

  "keyboardShortcut": "ctrl+shift+n",
  "welcomeMessage": "NATION AGENT v2 online — self-healing, persistent memory, MCP bridge active. What are we building?"
}
