{
  "name": "nation-agent",
  "description": "NATION AGENT v4 — Self-healing, persistent memory, MCP bridge, cross-platform (Termux + Linux), APK build/deploy, TUI, web dashboard, Ollama local AI, 24/7 auto-agent, Shizuku/ADB wireless. Alias: papy.",
  "prompt": "file:///root/.kiro/prompts/nation-agent.txt",

  "tools": [
    "read", "write", "shell", "grep", "glob", "code",
    "web_fetch", "web_search"
  ],

  "allowedTools": [
    "read", "grep", "glob", "code",
    "@filesystem",
    "@filesystem/read_file",
    "@filesystem/list_directory",
    "@filesystem/search_files",
    "@filesystem/get_file_info"
  ],

  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "~/**", "/root/**",
        "/data/data/com.termux/files/home/**"
      ],
      "deniedPaths": ["/etc/**", "/sys/**", "/proc/**", "/dev/**"]
    },
    "shell": {
      "allowedCommands": [
        "git", "python3", "python", "node", "npm", "pip3", "pip",
        "ls", "cat", "head", "tail", "find", "grep", "sed", "awk",
        "echo", "mkdir", "cp", "mv", "chmod", "touch", "wc", "sort",
        "uniq", "diff", "which", "env", "export", "date", "uname",
        "pwd", "whoami", "bash", "sh", "make", "curl", "pkg", "apt",
        "ollama", "adb",
        "~/.kiro/tools/",
        "/usr/local/bin/papy",
        "papy"
      ],
      "deniedCommands": [
        "rm -rf /", "rm -rf \\$HOME", "dd if=", "mkfs",
        "chmod -R 777 /", "> /dev/sda",
        "git push --force", "git reset --hard"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    },
    "web_fetch": {
      "trusted": [
        ".*github\\.com.*", ".*stackoverflow\\.com.*",
        ".*pypi\\.org.*", ".*docs\\.python\\.org.*",
        ".*nodejs\\.org.*", ".*httpbin\\.org.*"
      ]
    }
  },

  "resources": [
    "file://README.md",
    "file://.gitignore",
    "file://package.json",
    "file://requirements.txt",
    "file://Makefile",
    "skill://.kiro/skills/nation-tools/SKILL.md"
  ],

  "hooks": {
    "agentSpawn": [
      {
        "command": "~/.kiro/hooks/nation-spawn.sh",
        "timeout_ms": 25000
      }
    ],
    "preToolUse": [
      {
        "matcher": "*",
        "command": "~/.kiro/hooks/nation-pre-tool.sh",
        "timeout_ms": 5000
      }
    ],
    "postToolUse": [
      {
        "matcher": "*",
        "command": "~/.kiro/hooks/nation-post-tool.sh",
        "timeout_ms": 8000
      }
    ],
    "stop": [
      {
        "command": "~/.kiro/hooks/nation-stop.sh",
        "timeout_ms": 8000
      }
    ]
  },

  "mcpServers": {
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": ["/root", "/data/data/com.termux/files/home"],
      "timeout": 30000
    },
    "github": {
      "command": "mcp-server-github",
      "args": [],
      "env": { "GITHUB_TOKEN": "$GITHUB_TOKEN" },
      "timeout": 30000
    }
  },

  "keyboardShortcut": "ctrl+shift+n",
  "welcomeMessage": "⚡ NATION AGENT v4 — Ollama running, memory loaded, skills active. Type 'papy' anywhere. What are we building?"
}
